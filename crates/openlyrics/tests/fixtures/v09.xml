<?xml version="1.0" encoding="UTF-8"?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9" createdIn="OpenLP 3.0.2" modifiedIn="OpenLP 3.0.2" modifiedDate="2024-01-01T10:00:00">
  <properties>
    <titles>
      <title>Cuán Grande Es Él</title>
      <title>How Great Thou Art</title>
    </titles>
    <authors>
      <author type="words">Carl Boberg</author>
      <author type="translation" lang="es">Arturo W. Hotton</author>
      <author type="music">Carl Boberg</author>
    </authors>
    <copyright>Public domain</copyright>
    <ccliNo>14181</ccliNo>
    <verseOrder>v1 c v2 c</verseOrder>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines><chord root="G"/>Señor, mi Dios, al contemplar los cielos,<br/>
        el firmamento y las estrellas mil,<comment>slowly</comment><br/>al oír tu voz en los potentes truenos</lines>
      <lines>y ver brillar al sol en su cenit</lines>
    </verse>
    <verse name="c">
      <lines>Mi corazón entona la canción:<br/><tag name="red">¡Cuán grande es Él!</tag> &amp; más</lines>
    </verse>
    <verse name="v2">
      <instrument><beat><chord root="D"/></beat></instrument>
      <lines>Al recorrer los montes y los valles</lines>
    </verse>
  </lyrics>
</song>
